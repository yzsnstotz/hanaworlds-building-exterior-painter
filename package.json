{
  "name": "hanaworlds-building-exterior-painter",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "HanaWorlds C-painter v2: confirmed proposals to neutral BUILD plans and CIEDE2000 image material matching",
  "repository": {
    "type": "git",
    "url": "https://github.com/yzsnstotz/hanaworlds-building-exterior-painter.git"
  },
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "exports": {
    ".": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "GADGET.md",
    "LICENSE_AUDIT.md",
    "NOTICE",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "npm run build:runtime && npm run test:package-boundary",
    "test": "npm run test:unit && npm run test:package-boundary",
    "test:confirmed-placement": "node --test test/confirmed-placement.test.mjs",
    "test:site-rules": "node --test test/site-rules-v1.test.mjs",
    "test:local-world": "node --test test/local-world.test.mjs",
    "test:image-material": "node --test test/image-material.test.mjs",
    "test:material-sources": "node --test test/material-sources.test.mjs",
    "test:region": "node --test test/region-v1.test.mjs",
    "verify:contracts": "node tools/verify-contracts.mjs",
    "example": "node examples/provider-v2.mjs",
    "build:runtime": "node tools/build.mjs",
    "prepack": "node tools/prepack.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "test:package-boundary": "node tools/test-package-boundary.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "canonicalize": "5.1.0",
    "color-diff": "1.4.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "esbuild": "0.25.12",
    "pnpm": "11.28.5",
    "hanaworlds-contracts": "git+https://github.com/yzsnstotz/hanaworlds-contracts.git#v2.0.0"
  }
}
